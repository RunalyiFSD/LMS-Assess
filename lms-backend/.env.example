# ============================================
# LMS-Assess Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# ============================================

# Server
PORT=
NODE_ENV=

# Database
MONGO_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Frontend URL (for CORS / redirects)
CLIENT_URL=

# AI Module
AI_ENABLED=
AI_DEFAULT_PROVIDER=
GROQ_API_KEY=
