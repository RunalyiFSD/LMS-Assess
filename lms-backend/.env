PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lms-assessment
JWT_SECRET=super_secret_lms_assessment_key_123!
JWT_EXPIRES_IN=7d
NODE_ENV=development

# SMTP mail service mockup configs
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=noreply@lmsassessment.com

# OAuth configurations (Leave blank or empty to use Developer Simulation Fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# React Client URL (for backend redirection)
CLIENT_URL=http://localhost:5173

# Supabase Config
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
