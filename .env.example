# Global Environment Variables
# Copy these values into the respective .env files in each service folder.

# -----------------
# Frontend (lms-frontend/.env)
# -----------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------
# Backend (lms-backend/.env)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT config (for legacy/migration)
JWT_SECRET=super_secret_lms_assessment_key_123!
JWT_EXPIRES_IN=7d

# Email Mock (Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=noreply@lmsassessment.com

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# -----------------
# AI Platform (ai-platform/.env)
# -----------------
PORT=8000
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
